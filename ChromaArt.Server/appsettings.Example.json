{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "YOUR_CONNECTION_STRING_HERE"
  },
  "JwtSettings": {
    "Issuer": "ChromaArt.Server",
    "Audience": "chromaart.client",
    "AccessTokenExpirationTimeInMinutes": 10,
    "RefreshTokenExpirationTimeInDays": 2,
    "SecretKey": "YOUR_VALUE_HERE"
  },
  "ApifySettings": {
    "Token": "YOUR_VALUE_HERE"
  },
  "CloudinarySettings": {
    "CloudName": "YOUR_VALUE_HERE",
    "ApiKey": "YOUR_VALUE_HERE",
    "ApiSecret": "YOUR_VALUE_HERE"
  },
  "FrontendSettings": {
    "BaseUrl": "https://localhost:5173"
  },
  "EmailSettings": {
    "SmtpHost": "smtp.gmail.com",
    "SmtpPort": 587,
    "DefaultSender": "YOUR_VALUE_HERE",
    "DefaultPassword": "YOUR_VALUE_HERE"
  },
  "AllowedHosts": "*"
}
