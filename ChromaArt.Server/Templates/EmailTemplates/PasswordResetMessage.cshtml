@model string

<link rel="stylesheet" href="~/styles/style.css" />
<div class="container">
    <h2 class="title">
        Reset your password
    </h2>
    <p class="text">
        We received a request to reset the password for your ChromaArt account.
    </p>
    <p class="text">
        Click the button below to choose a new password:
    </p>
    <a class="button" href="@Model">
        Reset my password
    </a>
    <p class="text">
        If the button above doesn't work, copy and paste the following
        link into your browser:
    </p>
    <div class="link">
        <span>@Model</span>
    </div>
    <p class="text">
        If you didn't request a password reset, you can safely ignore
        this email. Your password will remain unchanged.
    </p>
    <footer class="footer">
        <p>
            &copy; @DateTime.UtcNow.Year ChromaArt. All rights reserved.
        </p>
    </footer>
</div>
